{
  "name": "tienlo-be-fe",
  "version": "1.1.2",
  "description": "TienLo Monorepo - NestJS Backend & Flutter Frontend",
  "private": true,
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "dev:be": "npm --prefix apps/backend run start:dev",
    "build:be": "npm --prefix apps/backend run build",
    "start:be": "npm --prefix apps/backend run start:prod",
    "test:be": "npm --prefix apps/backend run test",
    "lint:be": "npm --prefix apps/backend run lint",
    "dev:fe": "cd apps/frontend && flutter run",
    "build:fe:apk": "cd apps/frontend && flutter build apk",
    "build:fe:appbundle": "cd apps/frontend && flutter build appbundle",
    "build:fe:ios": "cd apps/frontend && flutter build ios --no-codesign",
    "test:fe": "cd apps/frontend && flutter test",
    "analyze:fe": "cd apps/frontend && flutter analyze"
  },

  "keywords": [
    "monorepo",
    "nestjs",
    "flutter",
    "tienlo"
  ],
  "author": "",
  "license": "ISC"
}
